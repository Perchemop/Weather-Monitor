{
  "name": "construction-weather-monitor",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first construction site weather monitoring and safety alerting enclave.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server-entry.ts",
    "build": "vite build && esbuild server-entry.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "build:static": "vite build --mode static",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "format:check": "node scripts/check-format.mjs",
    "format:check:changed": "node scripts/check-format.mjs --changed-from origin/main",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "tsx src/tests/system.test.ts && tsx src/tests/api.test.ts",
    "test:unit": "tsx src/tests/system.test.ts",
    "test:api": "tsx src/tests/api.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/nodemailer": "^8.0.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.1.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "vite": "^6.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
