# Construction Weather Monitor Environment Variables

# --- Weather Providers ---
# Optional WeatherAPI key. If omitted, the system falls back to Open-Meteo.
WEATHER_API_KEY=

# --- AI Superintendent Briefings (Google Gemini) ---
# Optional. When omitted, briefings fall back to a deterministic rule-based narrative.
GEMINI_API_KEY=

# --- Automated Email Alerts (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
OWNER_EMAIL=

# --- Security ---
# Random hex string used to sign session cookies. If omitted, a secret is
# generated once and persisted to data/session-secret so sessions survive
# restarts. Set explicitly for fully externalised secret management.
SESSION_SECRET=
# Emit Strict-Transport-Security (HSTS). Enable only when served over HTTPS.
ENABLE_HSTS=false
# Mark session cookies as Secure. Enable only when served over HTTPS.
# Leave false for the default plain-HTTP local enclave, otherwise login breaks.
SECURE_COOKIES=false
# Failed-login lockout policy (per account).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Minimum account password length (must also contain a letter and a number).
PASSWORD_MIN_LENGTH=10
# Requests allowed per client IP for the auth endpoints (15 min window), the
# general API (1 min window), and the AI endpoints (1 min window).
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=20

# --- Web Push Notifications (device alerts) ---
# Optional. If omitted, a VAPID key pair is generated once and persisted to
# data/vapid.json so existing subscriptions keep working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact subject for the VAPID token (mailto: or https: URL).
VAPID_SUBJECT=mailto:owner@localhost

# --- Logging ---
# One of: debug | info | warn | error.
LOG_LEVEL=info
# "pretty" for human-readable local output; JSON (default) for log shipping.
LOG_FORMAT=json

# --- Privacy / Offline Mode ---
# When true, the third-party WeatherAPI provider is skipped entirely and the
# open Open-Meteo service is used as the sole data source.
LOCAL_ONLY=false

# --- Storage ---
# Optional. Relocates the SQLite database, backups, and generated secrets.
# Defaults to ./data.
# DATA_DIR=/var/lib/weather-monitor
