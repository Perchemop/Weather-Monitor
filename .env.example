# Construction Weather Monitor Environment Variables

# --- Weather Providers ---
# Optional WeatherAPI key. If omitted, the system falls back to Open-Meteo.
WEATHER_API_KEY=

# --- Automated Email Alerts (SMTP) ---
# Only SMTP_HOST is required. Add SMTP_USER + SMTP_PASSWORD only when your relay
# requires authentication (hosted relays below do; local test relays do not).
#
# Local end-to-end test (no account needed):
#     docker compose --profile mail up --build
#     SMTP_HOST=mailpit
#     SMTP_PORT=1025
#     OWNER_EMAIL=safety@site.local
#   -> read the captured alert emails at http://localhost:8025
#
# Free hosted relays (SMTP_USER = account/login, SMTP_PASSWORD = the app key):
#     Brevo      smtp-relay.brevo.com    587
#     SMTP2GO    mail.smtp2go.com        2525
#     Mailjet    in-v3.mailjet.com       587
#     Gmail      smtp.gmail.com          587   (requires an App Password)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Default alert recipient.
OWNER_EMAIL=
# Optional explicit From header (defaults to SMTP_USER, or no-reply@localhost).
SMTP_FROM=

# --- Security ---
# Random hex string used to sign session cookies. If omitted, a secret is
# generated once and persisted to data/session-secret so sessions survive
# restarts. Set explicitly for fully externalised secret management.
SESSION_SECRET=
# Emit Strict-Transport-Security (HSTS). Enable only when served over HTTPS.
ENABLE_HSTS=false
# Mark session cookies as Secure. Enable only when served over HTTPS.
# Leave false for the default plain-HTTP local enclave, otherwise login breaks.
SECURE_COOKIES=false
# Failed-login lockout policy (per account).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Minimum account password length (must also contain a letter and a number).
PASSWORD_MIN_LENGTH=10
# Requests allowed per client IP for the auth endpoints (15 min window) and the
# general API (1 min window).
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300

# --- Web Push Notifications (device alerts) ---
# Optional. If omitted, a VAPID key pair is generated once and persisted to
# data/vapid.json so existing subscriptions keep working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact subject for the VAPID token (mailto: or https: URL).
VAPID_SUBJECT=mailto:owner@localhost

# --- Logging ---
# One of: debug | info | warn | error.
LOG_LEVEL=info
# "pretty" for human-readable local output; JSON (default) for log shipping.
LOG_FORMAT=json

# --- Metrics ---
# Optional shared token for scraping Prometheus metrics. When set, GET /metrics
# accepts `Authorization: Bearer <token>` (or ?token=<token>). When unset, the
# endpoint requires an authenticated session.
METRICS_TOKEN=

# --- Privacy / Offline Mode ---
# When true, the third-party WeatherAPI provider is skipped entirely and the
# open Open-Meteo service is used as the sole data source.
LOCAL_ONLY=false

# --- Storage ---
# Optional. Relocates the SQLite database, backups, and generated secrets.
# Defaults to ./data.
# DATA_DIR=/var/lib/weather-monitor
