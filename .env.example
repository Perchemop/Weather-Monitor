# Construction Weather Monitor Environment Variables

# --- Weather Providers ---
# Optional WeatherAPI key. If omitted, the system falls back to Open-Meteo.
WEATHER_API_KEY=

# --- AI Superintendent Briefings (Google Gemini) ---
# Optional. When omitted, briefings fall back to a deterministic rule-based narrative.
GEMINI_API_KEY=

# --- Automated Email Alerts (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
OWNER_EMAIL=

# --- Security ---
# Random hex string used to sign session cookies. Generated at boot if omitted,
# but should be set explicitly so sessions survive restarts.
SESSION_SECRET=
# Emit Strict-Transport-Security (HSTS). Enable only when served over HTTPS.
ENABLE_HSTS=false

# Set to true to disable all outbound weather/geocoding network calls.
LOCAL_ONLY=false
